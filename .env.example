# App URL (used for SEO, canonical URLs, Open Graph)
NEXT_PUBLIC_APP_URL=

# Shadcn Studio Credentials (if using premium components)
EMAIL=
LICENSE_KEY=

# Inquiry form → email to Maria via Resend (https://resend.com). Until both are set, the form falls back to
# opening the visitor's email app with their answers filled in.
RESEND_API_KEY=
# A sender on a domain verified in Resend, e.g. "Mr. Marketing Group <inquiries@mrmarketing-group.com>"
INQUIRY_FROM_EMAIL=
# Optional; defaults to siteConfig.email (Maria@mrmarketing-group.com)
INQUIRY_TO_EMAIL=
